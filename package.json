{
  "name": "padeswara-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:css": "pnpm dlx @tailwindcss/cli -i ./src/css/style-input.css -o ./src/css/style-output.css --watch",
    "dev": "concurrently \"pnpm dev:css\" \"pnpm dev:vite\"",
    "build:css-prod": "pnpm dlx @tailwindcss/cli -i ./src/css/style-input.css -o ./src/css/style-output.css --minify",
    "build": "pnpm build:css-prod && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1"
  }
}
